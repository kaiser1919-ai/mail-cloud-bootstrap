compatibility_level = 3.10
myhostname = {{ c.mail_host }}
myorigin = {{ c.domain }}
mydestination = $myhostname, localhost.localdomain, localhost
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 127.0.0.1/32
queue_directory = /srv/mail-cloud/data/postfix
message_size_limit = 26214400
queue_minfree = 104857600
mailbox_size_limit = 0
default_process_limit = 8
qmgr_message_active_limit = 100
qmgr_message_recipient_limit = 1000
virtual_mailbox_domains = {{ c.domain }}
virtual_mailbox_maps = ldap:/etc/postfix/ldap-mailboxes.cf
virtual_alias_maps = regexp:/etc/postfix/virtual-aliases
virtual_transport = lmtp:unix:private/dovecot-lmtp
smtpd_relay_restrictions = permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions = reject_unlisted_recipient
smtpd_sasl_auth_enable = no
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_security_options = noanonymous
smtpd_sender_login_maps = ldap:/etc/postfix/ldap-mailboxes.cf
smtpd_tls_security_level = may
smtpd_tls_cert_file = /etc/letsencrypt/live/{{ c.cloud_host }}/fullchain.pem
smtpd_tls_key_file = /etc/letsencrypt/live/{{ c.cloud_host }}/privkey.pem
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_auth_only = yes
smtp_tls_security_level = may
disable_vrfy_command = yes
smtpd_forbid_unauth_pipelining = yes
smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = inet:127.0.0.1:11332
milter_protocol = 6
milter_default_action = tempfail
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
recipient_delimiter =
