dovecot_config_version = 2.4.1
dovecot_storage_version = 2.4.1
instance_name = mail-cloud
base_dir = /run/dovecot
state_dir = /var/lib/dovecot
log_path = /dev/stderr
protocols {
 imap = yes
 lmtp = yes
}
listen = 0.0.0.0
ssl = required
ssl_min_protocol = TLSv1.2
ssl_server_cert_file = /etc/letsencrypt/live/{{ c.cloud_host }}/fullchain.pem
ssl_server_key_file = /etc/letsencrypt/live/{{ c.cloud_host }}/privkey.pem
auth_allow_cleartext = no
auth_mechanisms = plain login
auth_username_format = %{user | lower}
auth_cache_size = 0
default_process_limit = 8
default_client_limit = 64
mail_max_userip_connections = 4
mail_uid = mailcloud-vmail
mail_gid = mailcloud-vmail
first_valid_uid = 100
mail_driver = maildir
mail_home = /srv/mail-cloud/data/mail/%{user}
mail_path = %{home}/Maildir
ldap_uris = ldap://127.0.0.1:1389
ldap_auth_dn = cn=dovecot,ou=services,{{ suffix }}
ldap_auth_dn_password = {{ secrets.ldap_mail }}
ldap_base = ou=people,{{ suffix }}
passdb ldap {
 bind = yes
 ldap_filter = (&(objectClass=inetOrgPerson)(mail=%{user})(mail=*@{{ c.domain }}))
 fields {
  user = %{ldap:mail}
 }
}
userdb ldap {
 ldap_connection_group = userdb
 ldap_filter = (&(objectClass=inetOrgPerson)(mail=%{user})(mail=*@{{ c.domain }}))
 fields {
  home = /srv/mail-cloud/data/mail/%{ldap:mail}
 }
}
namespace inbox {
 inbox = yes
 separator = /
 mailbox Sent {
  auto = subscribe
  special_use = \Sent
 }
 mailbox Drafts {
  auto = subscribe
  special_use = \Drafts
 }
 mailbox Trash {
  auto = subscribe
  special_use = \Trash
 }
 mailbox Junk {
  auto = subscribe
  special_use = \Junk
 }
}
service imap-login {
 # TLS login processes can remain for the lifetime of each proxied connection.
 process_limit = 8
 inet_listener imap {
  port = 0
 }
 inet_listener imaps {
  port = 993
  ssl = yes
 }
}
service imap {
 process_limit = 16
}
service auth {
 unix_listener /srv/mail-cloud/data/postfix/private/auth {
  mode = 0660
  user = postfix
  group = postfix
 }
 unix_listener auth-userdb {
  mode = 0600
  user = root
  group = root
 }
}
service auth-worker {
 user = dovecot
}
service lmtp {
 process_limit = 2
 unix_listener /srv/mail-cloud/data/postfix/private/dovecot-lmtp {
  mode = 0600
  user = postfix
  group = postfix
 }
}
