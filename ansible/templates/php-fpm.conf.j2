[global]
pid = /run/mail-cloud-php/php.pid
error_log = syslog
syslog.ident = mail-cloud-php
syslog.facility = daemon
daemonize = no
[cloud]
user = mailcloud-nextcloud
group = mailcloud-nextcloud
listen = /run/mail-cloud-php/php.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 3
pm.process_idle_timeout = 30s
pm.max_requests = 300
clear_env = yes
catch_workers_output = yes
env[PATH] = /usr/local/bin:/usr/bin:/bin
env[TMPDIR] = /srv/mail-cloud/staging/nextcloud
php_admin_value[memory_limit] = 256M
php_admin_value[upload_max_filesize] = 512M
php_admin_value[post_max_size] = 512M
php_admin_value[max_execution_time] = 3600
php_admin_value[upload_tmp_dir] = /srv/mail-cloud/staging/nextcloud
php_admin_value[sys_temp_dir] = /srv/mail-cloud/staging/nextcloud
php_admin_flag[apc.enable_cli] = on
php_admin_value[opcache.interned_strings_buffer] = 16

; Private, bounded session store; the system-wide default is read-only here.
php_admin_value[session.save_path] = /srv/mail-cloud/data/php-sessions
php_admin_value[session.gc_probability] = 1
php_admin_value[session.gc_divisor] = 100
