# Native Ubuntu 24.04 / Dovecot 2.3. Not compatible with 2.4 syntax.
instance_name = mail-cloud
base_dir = /run/dovecot
state_dir = /var/lib/dovecot
log_path = /dev/stderr
protocols = imap lmtp
listen = 0.0.0.0
ssl = required
ssl_min_protocol = TLSv1.2
ssl_cert = </etc/letsencrypt/live/{{ c.cloud_host }}/fullchain.pem
ssl_key = </etc/letsencrypt/live/{{ c.cloud_host }}/privkey.pem
disable_plaintext_auth = yes
auth_mechanisms = plain login
auth_username_format = %Lu
auth_cache_size = 0
default_process_limit = 8
default_client_limit = 64
mail_max_userip_connections = 4
mail_uid = mailcloud-vmail
mail_gid = mailcloud-vmail
first_valid_uid = 100
mail_home = /srv/mail-cloud/data/mail/%u
mail_location = maildir:~/Maildir
passdb {
 driver = ldap
 args = /etc/dovecot/mail-cloud-ldap.conf
}
userdb {
 driver = ldap
 args = /etc/dovecot/mail-cloud-ldap.conf
}
namespace inbox {
 inbox = yes
 separator = /
 mailbox Sent {
  auto = subscribe
  special_use = \Sent
 }
 mailbox Drafts {
  auto = subscribe
  special_use = \Drafts
 }
 mailbox Trash {
  auto = subscribe
  special_use = \Trash
 }
 mailbox Junk {
  auto = subscribe
  special_use = \Junk
 }
}
service imap-login {
 # TLS login processes can remain for the lifetime of each proxied connection.
 process_limit = 8
 inet_listener imap {
  port = 0
 }
 inet_listener imaps {
  port = 993
  ssl = yes
 }
}
service imap {
 process_limit = 16
}
service auth {
 unix_listener /srv/mail-cloud/data/postfix/private/auth {
  mode = 0660
  user = postfix
  group = postfix
 }
 unix_listener auth-userdb {
  mode = 0600
  user = root
  group = root
 }
}
service auth-worker {
 user = dovecot
}
service lmtp {
 process_limit = 2
 unix_listener /srv/mail-cloud/data/postfix/private/dovecot-lmtp {
  mode = 0600
  user = postfix
  group = postfix
 }
}
